<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MySuite" parallel="tests" thread-count="4">

	<listeners>
		<listener class-name="com.orangehrm.listeners.MyListener"></listener>
	</listeners>

	<test name="chromeTest">
		<parameter name="browser" value="chrome"></parameter>
		<classes>

			<class name="com.orangehrm.tesetcases.TC001InvalidLoginTest"></class>
			<class name="com.orangehrm.tesetcases.TC002validLoginTest"></class>
			<class name="com.orangehrm.tesetcases.DB_EmployeeVerification"></class>
			<class name="com.orangehrm.tesetcases.APItest"></class><!--	-->
		</classes>
	</test>
	<test name="firefoxTest">
		<parameter name="browser" value="firefox"></parameter>
		<classes>

			<class name="com.orangehrm.tesetcases.TC001InvalidLoginTest"></class>
			<class name="com.orangehrm.tesetcases.TC002validLoginTest"></class>
			<class name="com.orangehrm.tesetcases.DB_EmployeeVerification"></class>
			<class name="com.orangehrm.tesetcases.APItest"></class><!--	-->
		</classes>
	</test>
	<test name="edgeTest">
		<parameter name="browser" value="edge"></parameter>
		<classes>

			<class name="com.orangehrm.tesetcases.TC001InvalidLoginTest"></class>
			<class name="com.orangehrm.tesetcases.TC002validLoginTest"></class>
			<class name="com.orangehrm.tesetcases.DB_EmployeeVerification"></class>
			<class name="com.orangehrm.tesetcases.APItest"></class><!--	-->
		</classes>
	</test>


</suite>
